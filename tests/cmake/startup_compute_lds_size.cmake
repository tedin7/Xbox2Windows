if(EXISTS "${INTAKE_PYTHON}")
    set(lds_size_check "${CMAKE_CURRENT_SOURCE_DIR}/tests/startup_compute_lds_size_check.py")
    add_test(NAME startup_compute_lds_size_controls COMMAND "${INTAKE_PYTHON}" -B "${lds_size_check}")
    if(DXC_EXECUTABLE AND TARGET offscreen_check)
        foreach(lds_case IN ITEMS dispatch 24k)
            foreach(mode IN ITEMS readback control)
                set(test_name startup_compute_lds_size_${lds_case}_${mode}_warp)
                add_test(NAME ${test_name} COMMAND "${INTAKE_PYTHON}" -B "${lds_size_check}"
                    ${mode} ${lds_case} "${DXC_EXECUTABLE}" "$<TARGET_FILE:offscreen_check>")
                set_tests_properties(${test_name} PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77)
            endforeach()
        endforeach()
    endif()
    unset(lds_size_check)
endif()

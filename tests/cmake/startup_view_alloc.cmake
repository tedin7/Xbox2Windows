# #1199: when a view container cannot allocate, nothing is recorded, the destination slot is untracked and the process
# keeps running. One test per allocation site. `control` never arms the failure, so the fixture must print FAIL.
add_executable(startup_view_alloc tests/startup_view_alloc.cpp)
target_compile_features(startup_view_alloc PRIVATE cxx_std_17)
target_link_libraries(startup_view_alloc PRIVATE d3d12_xs_shim d3d12 dxgi)
foreach(backend IN ITEMS warp hardware)
    foreach(site IN ITEMS records materialized ids)
        foreach(mode IN ITEMS on control)
            if(mode STREQUAL "on")
                set(alloc_test startup_view_alloc_${site}_${backend})
                add_test(NAME ${alloc_test} COMMAND startup_view_alloc ${backend} ${site})
            else()
                set(alloc_test startup_view_alloc_${site}_control_${backend})
                add_test(NAME ${alloc_test} COMMAND startup_view_alloc ${backend} ${site} control)
            endif()
            set(alloc_env "X2W_D3D12_BUDGET=1;X2W_D3D12_RELEASE_RETIRED=1;X2W_D3D12_PERMISSIVE=1;X2W_D3D12_RENDER=1")
            list(APPEND alloc_env "X2W_D3D12_DEBUG=0" "X2W_TRAP_LOG=${CMAKE_CURRENT_BINARY_DIR}/${alloc_test}.log")
            set_tests_properties(${alloc_test} PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77 ENVIRONMENT "${alloc_env}")
            if(mode STREQUAL "control")
                set_tests_properties(${alloc_test} PROPERTIES
                    PASS_REGULAR_EXPRESSION "FAIL: a failed publication changed a view container")
            endif()
        endforeach()
    endforeach()
endforeach()

{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    {
      "name": "pr",
      "configurePreset": "dev",
      "targets": [
        "d3d12_sdk_check", "era_heap_check", "xmem_shim", "offscreen_check",
        "cpu_fuzz_lifted", "cpu_fuzz_lifted_o2", "pe_map", "intake_candidate",
        "archive_gpu_reader", "archive_codec_gpu", "archive_texture_gpu_lifted", "startup_launch_probe",
        "startup_indirect_dispatch", "startup_indirect_draw_indexed", "startup_present_readback_check",
        "xmem_shim_test_controls", "startup_stub_xcrdapi", "startup_stub_xcrdapi_break_window_control",
        "xmem_run_break_readers_check", "xmem_run_break_readers_control", "xmem_cross_call_merge_check",
        "xmem_placeholder_split_check", "xmem_map_split_first_check", "startup_dstorage_break_window_check",
        "xmem_page_runs_device_check", "linear_buffer_backing_check"
      ]
    },
    { "name": "release", "configurePreset": "release" },
    { "name": "runtime", "configurePreset": "release", "targets": ["startup_runtime"] }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    {
      "name": "pr",
      "inherits": "dev",
      "displayName": "Windows pull request smoke tests",
      "filter": {
        "include": {
          "name": "^(desktop_root_signature|era_heap_(allocation|failure)|xmem_shim_mapped_pages|cpu_aot_fuzz_smoke|cpu_archive_texture_gpu_warp|dual_uav_warp|spirv_.*_warp|static_exe_intake|descriptor_heap_paging(_swapped)?_warp|startup_launch|startup_tools_lint|startup_gfx2hlsl_cvt_off_f32_i4_controls|startup_gfx2hlsl_sad_hi_msad_controls|startup_indirect_(dispatch|count_split|draw(_indexed)?|mesh(_xmem_arguments(_skip_wait)?)?|counts_control)_warp|startup_indirect_mesh_lease_warp_dual(-trace(-disabled)?)?|startup_shader_cache_key|startup_present_readback|xmem_(run_break_readers|cross_call_merge|placeholder_split|map_split_first)(_[a-z_]+)?|startup_dstorage_break_window(_[a-z_]+)?|xmem_page_runs_device(_join)?_warp|linear_buffer_backing_share_warp|startup_stage_package)$"
        }
      }
    },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
